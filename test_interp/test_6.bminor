// ========================================
// Búsqueda Binaria y Algoritmos de Arrays
// ========================================

// Función para llenar array con valores
llenar_array: function void (arr: array [] integer, n: integer) = {
    i: integer;
    for (i = 0; i < n; i++) {
        arr[i] = i * 2 + 1;  // Números impares: 1, 3, 5, 7, ...
    }
}

// Búsqueda binaria iterativa
busqueda_binaria: function integer (arr: array [] integer, n: integer, target: integer) = {
    izq: integer;
    der: integer;
    mid: integer;
    
    izq = 0;
    der = n - 1;
    
    while (izq <= der) {
        mid = izq + (der - izq) / 2;
        
        if (arr[mid] == target) {
            return mid;
        }
        
        if (arr[mid] < target) {
            izq = mid + 1;
        } else {
            der = mid - 1;
        }
    }
    
    return -1;  // No encontrado
}

// Búsqueda lineal (para comparación)
busqueda_lineal: function integer (arr: array [] integer, n: integer, target: integer) = {
    i: integer;
    for (i = 0; i < n; i++) {
        if (arr[i] == target) {
            return i;
        }
    }
    return -1;
}

// Invertir array in-place
invertir_array: function void (arr: array [] integer, n: integer) = {
    i: integer;
    temp: integer;
    mitad: integer;
    
    mitad = n / 2;
    
    for (i = 0; i < mitad; i++) {
        temp = arr[i];
        arr[i] = arr[n - 1 - i];
        arr[n - 1 - i] = temp;
    }
}

// Imprimir array
imprimir_array: function void (arr: array [] integer, n: integer) = {
    i: integer;
    print "[ ";
    for (i = 0; i < n; i++) {
        print arr[i];
        if (i < n - 1) {
            print ", ";
        }
    }
    print " ]\n";
}

main: function integer () = {
    numeros: array [20] integer;
    tam: integer;
    buscar: integer;
    resultado: integer;
    i: integer;
    
    tam = 20;
    
    print "=== PRUEBA DE ALGORITMOS DE BUSQUEDA ===\n\n";
    
    // Llenar array
    llenar_array(numeros, tam);
    
    print "Array ordenado: ";
    imprimir_array(numeros, tam);
    print "\n";
    
    // Probar búsquedas
    print "--- Busquedas ---\n";
    
    buscar = 15;
    resultado = busqueda_binaria(numeros, tam, buscar);
    print "Busqueda binaria de ", buscar, ": ";
    if (resultado != -1) {
        print "encontrado en indice ", resultado, "\n";
    } else {
        print "no encontrado\n";
    }
    
    buscar = 25;
    resultado = busqueda_lineal(numeros, tam, buscar);
    print "Busqueda lineal de ", buscar, ": ";
    if (resultado != -1) {
        print "encontrado en indice ", resultado, "\n";
    } else {
        print "no encontrado\n";
    }
    
    buscar = 100;
    resultado = busqueda_binaria(numeros, tam, buscar);
    print "Busqueda binaria de ", buscar, ": ";
    if (resultado != -1) {
        print "encontrado en indice ", resultado, "\n";
    } else {
        print "no encontrado\n";
    }
    
    // Invertir array
    print "\n--- Inversion de Array ---\n";
    print "Array original: ";
    imprimir_array(numeros, tam);
    
    invertir_array(numeros, tam);
    
    print "Array invertido: ";
    imprimir_array(numeros, tam);
    
    return 0;
}
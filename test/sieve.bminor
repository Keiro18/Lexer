/* ========================================================================== *
 *                                                                            *
 * sieve.bminor - VERSIÓN CORREGIDA                                          *
 *                                                                            *
 * Implementación del Algoritmo de Eratóstenes                                *
 *                                                                            *
 * ========================================================================== */

N: integer = 100;
isprime: array [N] boolean;

main: function void () = {
    i: integer;
    j: integer;

    // Inicializar todos como primos
    for (i = 0; i < N; i = i + 1) {
        isprime[i] = true;
    }

    // 0 y 1 no son primos
    isprime[0] = false;
    isprime[1] = false;

    // Criba de Eratóstenes
    i = 2;
    while (i * i < N) {
        if (isprime[i]) {
            j = i * i;
            while (j < N) {
                isprime[j] = false;
                j = j + i;
            }
        }
        i = i + 1;
    }

    // Imprimir primos
    print "Primos menores que 100:";
    for (i = 2; i < N; i = i + 1) {
        if (isprime[i]) {
            print i;
        }
    }
}
    print "========================================\n";
    print "   SUITE DE PRUEBAS - B-MINOR\n";
    print "========================================\n";
    
    print "\n=== VARIABLES GLOBALES ===\n";
    print "x = ";
    print x;
    print ", y = ";
    print y;
    print "\n";
    print "pi = ";
    print pi;
    print "\n";
    print "nombre = ";
    print nombre;
    print "\n";
    print "activo = ";
    print activo;
    print "\n";
    
    print "\n=== OPERACIONES BASICAS ===\n";
    print "suma(10, 20) = ";
    print suma(10, 20);
    print "\n";
    print "resta(50, 30) = ";
    print resta(50, 30);
    print "\n";
    print "multiplica(6, 7) = ";
    print multiplica(6, 7);
    print "\n";
    print "divide(100, 5) = ";
    print divide(100, 5);
    print "\n";
    
    prueba_if_else();
